# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prospecting data/logs — never publish (repo is public)
prospecting/*.csv
prospecting/*.log
prospecting/*.txt
prospecting/*.json
prospecting/.*
prospecting/__pycache__/
prospecting/HOT-LEADS.txt
prospecting/REVIEW.txt
